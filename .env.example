# Variables de entorno para Railway / producción
# NO subir valores reales de contraseña.

# Puerto (Railway lo proporciona automáticamente, pero puedes dejarlo si quieres local):
PORT=3002

# MySQL (proporcionadas por Railway plugin MySQL)
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=inventario360

# Imágenes persistentes (en Railway, crear un volumen montado en esta ruta)
UPLOADS_DIR=/app/uploads

# CORS (url de tu app Railway)
ALLOWED_ORIGINS=http://localhost:3002,https://inventario360-production.up.railway.app

# SMTP para códigos de verificación por correo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Brevo HTTPS API (recomendado en Railway Free, Trial y Hobby; usa HTTPS en lugar de SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Inventario 360

# Brevo SMS transaccional (remitente aprobado, máximo 11 caracteres alfanuméricos)
BREVO_SMS_SENDER=Inventario

# Brevo WhatsApp transaccional (número empresarial, incluido el código de país)
BREVO_WHATSAPP_SENDER_NUMBER=
BREVO_WHATSAPP_TEMPLATE_ID=
# Nombre exacto del parámetro del código configurado en la plantilla (por defecto CODE)
BREVO_WHATSAPP_CODE_PARAM=CODE

# Node env
NODE_ENV=production
